{
  "manifest_version": 3,
  "name": "Liquid Glass Clock",
  "version": "1.1",
  "description": "Relógio transparente estilo liquid glass no canto inferior direito",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": false,
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Liquid Glass Clock"
  }
}
